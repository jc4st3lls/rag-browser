# Stage 1: Construir el frontend Vite utilizando Node.js
# Se asume que el paquete WASM ya ha sido compilado localmente en crates/embedder/pkg
FROM node:20-bookworm-slim AS frontend-builder

WORKDIR /app

# Copiar el paquete WASM precompilado desde el host
COPY crates/embedder/pkg ./crates/embedder/pkg

# Copiar proyecto frontend
COPY www ./www

WORKDIR /app/www
RUN npm install
RUN npm run build

# Stage 2: Nginx para servir el frontend y proxy a la API
FROM nginx:alpine

COPY --from=frontend-builder /app/www/dist /usr/share/nginx/html
COPY www/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
